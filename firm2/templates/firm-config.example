# Пример .firm/config — кладётся в КОРЕНЬ целевого проекта (не в плагин).
# Один конфиг на проект: два означали бы два места, где записан стек и команды тестов.

# Какой движок ведёт этот проект. Ключ читают хуки: без `firm2` события переходов
# НЕ пишутся вовсе. Хуки плагина видны во ВСЕХ проектах, а журнал нужен только там,
# где маршрут ведёт поставку, — этот ключ и есть граница.
engine: firm2
engine_version: "0.4.142"

# Абсолютный путь к каталогу плагина firm2. Гоняем ИСХОДНИК, а не ~/.claude/plugins/cache:
# кэш отстаёт — это проверенные грабли, а не предположение.
engine_root: "/absolute/path/to/marketplace/firm2"

# Какая поставка живая — ОБЪЯВЛЕНИЕ человека, и оно сильнее любого расчёта движка.
# Ключ нужен только когда в `openspec/changes/` лежит больше одной живой поставки; при
# одной движок видит её и так, и ключ лишний. Имя — каталог поставки целиком.
#
# Зачем он есть: при двух папках движку пришлось бы угадывать, а все дефекты привязки
# 11.10.2026 выросли ровно из этой догадки (CHANGELOG 0.4.71). Имя, которого среди живых
# поставок нет, НЕ лечится тихим откатом к расчёту: активная поставка тогда не определена,
# `doctor` краснеет и называет причину.
#
# Но обычный порядок другой и лучше: живая поставка одна, остальные планы лежат в бэклоге
# до своей очереди. Ключ — для случая, когда одной обойтись нельзя.
# active_change: "2026-10-10-the-game-in-the-middle"

# Потолок одновременно идущих задач (каждая в своём worktree).
parallelism: 3

# ПОЛОСЫ ОДНОВРЕМЕННОСТИ: «метка → сколько стадий этой полосы вести разом». Третье
# состояние между «идёт со всеми» (parallel_safe: true) и «идёт одна»
# (parallel_safe: false). Нужен, когда одновременность ограничена МАШИНОЙ, а не общими
# файлами: восемь браузеров разом не поднимаются, сколько бы ни стоял parallelism.
#
# Ключа нет — поведение прежнее. Задача попадает в полосу по своей метке, нового поля ей
# не нужно. Потолок называют ЗАМЕРОМ своего проекта: у проект-В общий бегунок живых проверок
# дал на concurrency 4 ускорение 2,59× и три мигающих красных — то есть цена одновременности
# там известна, и потолок ставится по ней, а не по вкусу.
#
# «Не одновременно НИ С КЕМ» — это parallel_safe: false у задачи, а не нуль здесь: нуль
# в полосе — находка ворот, потому что читается как запрет, а значил бы «ключа нет».
# lanes:
#   требует-браузера: 1

# Рабочие деревья задач — ВНЕ репозитория: codegraph индексирует дерево целиком и
# посчитал бы worktree внутри репозитория за отдельную копию кода.
worktrees_dir: "../<repo>.worktrees"

# Рабочие деревья ГРУМИНГА — отдельным каталогом (ADR-0012), а не внутри worktrees_dir:
# уборка поставки считает своим всё, что лежит в worktrees_dir, и смешивать два вида
# деревьев значило бы отдать деревья груминга уборке. По умолчанию — сосед репозитория.
# groom_dir: "../<repo>.groom"

# База, от которой заводятся ветки груминга. По умолчанию main, иначе master.
# main_branch: main

# Общий стенд живой проверки в браузере: сборка, запуск браузера, подключение, уборка.
# Движок стенд НЕ пишет — он знает про стек и экраны проекта, — но держит его адрес:
# отсюда путь уезжает в промпт браузерной стадии, и роль перестаёт искать стенд grep-ом.
# Ключа нет и браузерных задач в поставке две или больше — `firm-state.mjs criteria`
# требует завести стенд ПЕРВОЙ задачей поставки. Замер, из которого это правило выросло:
# 30 браузерных проверок, 12 010 строк, ноль импортов общего модуля, ~400 строк обвязки
# на задачу — и один из тридцати стендов положил профиль Chrome внутрь репозитория.
# browser_harness: "web/test/browser/support.mjs"

# Бинарь браузера для живой проверки — абсолютным путём. Отсюда он уезжает в промпт
# браузерной стадии, и роль перестаёт его искать: рецепт она получает правилом, а путь
# правилом не передашь — в имени каталога стоит версия, и на каждой машине она своя.
# Замер 11.10.2026: системный Chrome под песочницей НЕ поднимается ни в одном режиме
# `--headless` (`ProcessSingleton` требует unix-сокета, `bind()` запрещён, Chrome
# прекращает работу сам), а `chrome-headless-shell` с `--single-process` поднимается, и CDP
# через `--remote-debugging-pipe` работает целиком. `--no-sandbox` не добавлять — с ним
# падает. Ставится один раз на машину, человеком:
#   npx -y @puppeteer/browsers install chrome-headless-shell@stable
# Названный путь, за которым нет файла, `firm-state.mjs criteria` называет находкой.
# browser_binary: "/Users/me/.cache/chrome-headless-shell/mac_arm-155.0.8059.39/chrome-headless-shell-mac-arm64/chrome-headless-shell"

# Короткая полоса: пути, правка внутри которых не открывает стадии тестов и ревью.
# Работает только вместе с меткой `короткая-полоса`, которую ставит Архитектор на
# планировании, и только если НАСТОЯЩИЙ дифф ветки задачи целиком уложился в эти пути —
# вышел за них, задача идёт полным циклом (`firm-state.mjs lane-check --ticket T-XXX`).
# Ключа нет — метка не делает ничего, и прогон говорит об этом в лог.
#
# Здесь перечисляются пути, где живёт ТЕКСТ и документация: словари интерфейса, строки,
# `docs/`. Логика, запросы и миграции сюда не попадают, какой бы короткой правка ни была.
# Образцы: `*` в пределах сегмента, `**` через сегменты.
#
# Компоненты в список не вносят: файл ВНЕ путей полосу не отменяет, если в диффе у него
# только удаления (ввести логику удалением нельзя), хотя бы один файл диффа лежит внутри
# путей, а всего вне них удалено не больше `max_deleted_lines` строк — по умолчанию 40,
# замер мелкой правки с запасом.
# short_lane:
#   paths:
#     - "web/src/texts/**"
#     - "docs/**/*.md"
#   max_deleted_lines: 40

# Замер массы (`firm-state.mjs mass`): какие пути считать проверками. Ключ нужен только
# если признак по имени пути (`tests/`, `test_x.py`, `x_test.go`, `x.test.ts`, `__tests__/`,
# `e2e/`) в этом проекте не работает. Названные пути ОТМЕНЯЮТ признак, а не дополняют его.
# mass:
#   test_paths:
#     - "checks/**"

# Счёт контекста движка (`context-bill.mjs`). Он считает символы — это замер, — а токены
# пересчитывает по коэффициенту, который на вашей машине никто не мерил. Есть свой замер
# (например из `/context`) — впишите, и счёт пойдёт по нему. Бюджеты находок задаются в
# СИМВОЛАХ намеренно: порог в токенах держался бы на невымеренном числе.
# context:
#   chars_per_token_cyr: 2.1
#   chars_per_token_other: 3.8
#   budget_description: 400      # описание лежит в окне каждой сессии
#   budget_command: 26000        # тело команды дочитывается при вызове
#   budget_skill: 8000           # тело приёма — когда роль его позвала
#   budget_stage: 26000          # роль плюс всё, что она может дочитать

codegraph:
  enabled: true
  required_for_code: warn    # warn — предупреждение, не блокировка

designer:
  enabled: true

dashboard:
  publish_artifact: on_demand

# Стек проекта. test_cmd/lint_cmd DevOps пропишет в проектный allowlist на scaffold.
stack:
  language: "python"
  package_manager: "uv"
  test_cmd: "pytest"
  lint_cmd: "ruff check ."

# Модели ролей. Переопределяют модель из frontmatter роли — так проект поднимает
# или опускает конкретную роль, не трогая её общий промпт.
# Допустимые значения: opus | sonnet | haiku | inherit или полное имя модели (claude-sonnet-5-5):
# алиас рантайм разрешает в текущую версию, полное имя закрепляет роль на конкретной.
#   inherit или отсутствующий ключ — роль идёт на своей модели (оверрайд не передаётся);
#   неизвестный ключ или значение — отбрасывается с предупреждением в firm-state models,
#   чтобы опечатка не превратилась в отказ API на середине сборки.
models:
  pm: "inherit"              # opus по роли
  architect: "inherit"       # opus по роли
  designer: "inherit"        # opus по роли
  developer: "sonnet"
  developer_high_complexity: "opus"   # задачи с меткой high-complexity; правило движка
  tester: "sonnet"
  # Тестировщик на задачах с меткой high-complexity. Ключа нет — эскалации нет: без него
  # ничего не дорожает молча. Довод за то, чтобы его поставить: на этой метке код пишут
  # сильной моделью именно потому, что задача сложная, — а тесты к нему писались бы слабой,
  # то есть проверяющий слабее проверяемого там, где сложность объявлена явно.
  # tester_high_complexity: "opus"
  # Ревьюер идёт на sonnet, и это решение про деньги, принятое с открытыми глазами.
  # На рискованной задаче (метки high-complexity или факточувствительный) ревью ведёт
  # ПАНЕЛЬ из трёх независимых голосов, и на каждую попытку. С opus это три дорогих
  # прогона за попытку при том, что вердикт выносится против ЯВНЫХ критериев приёмки,
  # а не вкусом: разбор по критериям машинный и попадает в событие ревью.
  # Поставка, где цена ошибки выше цены прогона, поднимает ключ обратно в "opus".
  reviewer_qa: "sonnet"
  docwriter: "sonnet"
  devops: "haiku"

# Самые дорогие слова в задаче — метки `high-complexity` и `факточувствительный`:
# первая включает панель из трёх ревьюеров И поднимает Разработчика на opus (а при
# заполненном ключе tester_high_complexity — и Тестировщика), вторая включает панель.
# Ставить их по делу, а не на всякий случай.

dependencies:
  mattpocock-skills: "1.2.3"
  openspec: "1.11.0"         # Node 20.19+
  codegraph: "3.17.0"        # @optave/codegraph

monitor:
  # Час, а не десять минут. Монитор — это loop ВНУТРИ сессии человека, и стоимость тика
  # определяется не сводкой, а тем, что модель сессии заново обрабатывает весь накопленный
  # контекст. Отсюда два следствия: частый тик дорог, а вынос сводки в дешёвого субагента
  # почти ничего не даёт. Нужны частые сводки — держи монитор в ОТДЕЛЬНОЙ свежей сессии,
  # где контекст мал. Дашборд при этом бесплатен: он пересобирается на каждом событии.
  interval: "1h"
  # Со скольких минут стадия считается «долго идущей». Не убивает её — движок этого не
  # умеет и не пытается, — а называет в сводке монитора и в `doctor`.
  #
  # Ключа ЗДЕСЬ ПО УМОЛЧАНИЮ НЕТ, и это осознанно: порог считает сам движок, отдельно для
  # каждой стадии, по журналу ЭТОГО проекта — p95 его же законченных стадий такого типа,
  # округлённый вверх до пяти минут. Пока стадий меньше двадцати, берётся замер пилотов
  # (dev 45, test 25, review 20, adjudicate 30, остальные 30).
  #
  # Почему не одно число: по 628 стадиям четырёх пилотов p95 у `dev` — 38 минут, у
  # `review` — 16. Общий порог 25 одновременно шумел на разработке (каждая десятая
  # стадия дольше) и молчал на ревью (втрое выше его нормы). Разброс между проектами
  # того же порядка: p95 стадии `dev` — 52 минуты на одном пилоте и 21 на другом.
  #
  # Раскомментировать стоит, только если про этот проект известно больше, чем видно в
  # его журнале: значение перекрывает расчёт и применяется СРАЗУ КО ВСЕМ стадиям.
  # long_stage_min: 25

# host-agnostic: github → gh (PR), gitlab → glab (MR). Токен сюда НЕ кладём.
# Области кода проекта. Нужны одной проверке: движок сверяет пометки задачи
# (`ui: true/false`, метка «требует-браузера») с тем, что ветка задачи ПРАВИЛА на самом
# деле. Имя `ui` особенное — именно с ним сверяется флаг; остальные имена произвольны.
# Перечисление путей через запятую, сравнение по началу пути.
#
# Нет этой секции — проверка молчит: угадать за проект, что у него экран, а что сервер,
# движок не может, а выдумать значило бы соврать (ADR-0007).
#
# Зачем это нужно (замер обкатки проект-В, 66 влитых задач по фактическому диффу):
# задачи, правящие И экран, И сервер, дали 1.95 бага на задачу против 1.09 у чисто
# серверных, и 77% этих дефектов нашёл человек на демо, а не автоматический контур.
# А сам флаг `ui` расходился с диффом у 13 задач из 66 — в обе стороны: задача на
# 14 файлов экрана шла с `ui: false`, то есть мимо Дизайнера и мимо макета.
# areas:
#   ui: "web/"
#   server: "app/, api/"

# Секция читается КОДОМ (с 0.4.63), а не только промптом DevOps: `doctor` и `phase` сверяют
# её с настоящим репозиторием и называют расхождение — нет удалённого, назван
# несуществующий remote, нет целевой ветки. Сборку это не блокирует, но и не молчит до шага
# выдачи, где прежде всё и всплывало: PR оформить нечем, а поставка уже сделана.
# Секции нет вовсе — проверка молчит: проект ведёт выдачу руками, и это законно.
vcs:
  host: "github"
  remote: "origin"
  target_branch: "main"

# Защита главного рабочего дерева от записи стадии (хук PreToolUse на Write|Edit).
# Пока живо хотя бы одно рабочее дерево задачи, запись по пути внутри главного дерева
# отклоняется — кроме .firm/, openspec/, docs/, .claude/, которые принадлежат поставке,
# а не задаче. Так тесты T-105 ушли мимо ветки и сорвали слияние (пилот 23.09.2026).
# Отключать только на случай, который в защите не предусмотрен: off виден здесь, а не
# спрятан в коде.
guard:
  write_outside_worktree: on
  # Снятие песочницы стадией (`dangerouslyDisableSandbox`). По умолчанию запрещено кодом:
  # хук PreToolUse(Bash) отклоняет такой вызов, если он идёт ИЗ рабочего дерева задачи.
  # Из главного дерева вызов проходит — там работает человек, и мешать ему движок права
  # не имеет (ADR-0009).
  #
  # До 0.4.61 запрет жил только в тексте промптов ролей, и это ничего не стоило: на T-057
  # (проект-В) Разработчик песочницу снял, и узналось об этом лишь потому, что он сам честно
  # написал об этом в отчёте. Промолчи он — следа не осталось бы нигде.
  #
  # `allow` — вызовы проходят, но каждый пишется событием `guard/sandbox-off`. Ставить,
  # если снятие нужно проекту по делу: видимое разрешение лучше невидимого обхода.
  #
  # РАДИ БРАУЗЕРА ЭТОТ КЛЮЧ НЕ НУЖЕН. 11.10.2026 на проект-В браузерные стадии трижды за
  # вечер упёрлись в стену «браузер недоступен», и проект уже собирался поставить `allow`.
  # Замер показал, что открывать машину нечего: `chrome-headless-shell --single-process`
  # поднимается ПОД песочницей, и CDP через `--remote-debugging-pipe` работает целиком
  # (`Runtime.evaluate` отдал живой `getBoundingClientRect`, `Page.captureScreenshot` — PNG).
  # Системный Chrome не поднимается ни в одном режиме `--headless`: ему нужен unix-сокет
  # для `ProcessSingleton`, а `bind()` песочница запрещает. `--no-sandbox` не добавлять.
  # Бинарь ставится один раз на машину, человеком:
  #   npx -y @puppeteer/browsers install chrome-headless-shell@stable
  # sandbox_off: block
  #
  # Секрет в коммите. По умолчанию `block`: хук PreToolUse(Bash) читает дифф, который едет
  # в коммит, и отменяет вызов, если в ДОБАВЛЕННЫХ строках узнаёт ключ по форме (префиксы
  # AWS/GitHub/Slack/Stripe/Anthropic, закрытый ключ, JWT, пароль в строке подключения) или
  # присваивание ключу с говорящим именем. Git-хук `pre-commit` для этого не годится: он
  # снимается флагом `--no-verify`, и снимает его та же роль, которой он мешает.
  #
  # Проверка смотрит только на новое: секрет, уже лежащий в истории, ею не чинится — его
  # чинит отзыв ключа. Ложная находка снимается ОГОВОРКОЙ В СТРОКЕ кода, с причиной:
  #   token = "eyJhbGciOi..."  # firm2: не секрет — тестовый вектор из RFC 7515
  # Оговорка без причины не считается, и каждая попадает в журнал событием `guard/secret`.
  #
  # `warn` — коммит проходит, находка пишется событием. Любое другое значение читается как
  # `block`: опечатка в конфиге не должна молча снимать защиту (И-12).
  # secret_scan: block
