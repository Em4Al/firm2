#!/usr/bin/env bash
# Git-хук коммита для проекта под firm2. Кладётся в .git/hooks/pre-commit (chmod +x).
#
# ВТОРОЙ слой сверки секретов, и слой этот нужен именно вторым. Первый — `PreToolUse`
# рантайма (`scripts/secret-scan.mjs`): он отменяет вызов ДО работы, но видит только те
# команды, которые роль напечатала узнаваемой формой. Замер проект-В 04.11.2026 (Д-48): два
# события «коммит ОТМЕНЁН», а те же три находки лежат в коммите — он прошёл формой, которой
# признак не знал (`merge --continue` после конфликта). Git-хук видит КАЖДЫЙ коммит, чем бы
# он ни был создан; обходится он флагом `--no-verify`, и это его известная дыра. Дыры у двух
# слоёв разные, и обойти оба сразу случайной формой команды нельзя.
#
# Молчит везде, где это не проект firm2: чужие репозитории нас не касаются.
set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$root" ] || exit 0
cfg="$root/.firm/config"
# Связанное рабочее дерево: `.firm/config` лежит в ГЛАВНОМ дереве, а коммитят здесь.
if [ ! -f "$cfg" ]; then
  main="$(git worktree list --porcelain 2>/dev/null | sed -nE '1s/^worktree //p')"
  [ -n "$main" ] && cfg="$main/.firm/config"
fi
[ -f "$cfg" ] || exit 0
grep -qE '^engine:[[:space:]]*firm2[[:space:]]*$' "$cfg" || exit 0

engine_root="$(sed -nE 's/^engine_root:[[:space:]]*"?([^"]+)"?[[:space:]]*$/\1/p' "$cfg" | head -1)"
[ -n "$engine_root" ] || exit 0
scan="$engine_root/scripts/secret-scan.mjs"
[ -f "$scan" ] || exit 0

# Движок зовётся из дерева, в котором коммитят: индекс спрашивается здесь же.
# Окружение git снимаем — внутри node оно сильнее ключа `-C` (та же ловушка, что в post-merge).
env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE node "$scan" --staged
