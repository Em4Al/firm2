#!/usr/bin/env bash
# Git-хук слияния для проекта под firm2. Кладётся в .git/hooks/post-merge (chmod +x).
#
# Делает ровно два дела, и оба — те, которые нельзя доверить шагу внутри движка,
# потому что шаг можно обойти, а git-хук нет:
#   1. пишет событие слияния (merge/finished для задачи, release/finished для поставки);
#   2. обновляет граф кода.
#
# Молчит везде, где это не проект firm2: чужие репозитории нас не касаются.
set -uo pipefail

# Корень — ГЛАВНОЕ рабочее дерево, а не то, в котором случилось слияние. `--show-toplevel`
# внутри дерева задачи вернул бы его путь, и события уехали бы в `.firm/events` ветки
# задачи: журнал поставки раздваивается, а при возврате на ветку поставки половина
# исчезает. Первая запись `worktree list --porcelain` — всегда главное дерево.
# Найдено ревью по инвариантам 01.10.2026.
root="$(git worktree list --porcelain 2>/dev/null | sed -nE '1s/^worktree //p')"
# `$root` ниже служит ТОЛЬКО путём к `.firm/config` и журналу. Ни одного вопроса к git
# «про главное дерево» в хуке нет, и это не упущение: все вопросы здесь — про дерево, где
# слияние случилось. Если такой вопрос когда-нибудь понадобится, `-C "$root"` для него
# НЕ ХВАТИТ: git запускает хук с выставленным `GIT_DIR` (в связанном дереве —
# `.git/worktrees/<имя>`), а переменная окружения сильнее `-C`, так что `git -C "$root" …`
# молча ответит про текущее дерево, а читаться будет как вопрос про главное. Снимать
# придётся само окружение: `env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git -C "$root"`.
#
# Внутри node эта ловушка закрыта ЦЕНТРАЛЬНО с 03.11.2026: `scripts/lib/firm.mjs` снимает
# `GIT_DIR`/`GIT_WORK_TREE`/`GIT_INDEX_FILE` (и прочее семейство) на входе, один раз на
# процесс. До этого предупреждение выше было написано — и не исполнено этажом ниже: запись
# события делала `git -C root add`, путь брала из `root`, а индекс из дерева слияния.
# Выпуск проект-В 03.11.2026 дал 139 записей `AD` в дереве слияния и 139 неотслеживаемых
# файлов в главном — то есть защита от `git clean -fd` не сработала ровно там, ради чего
# стоит. Правило для хука не меняется: его собственные вопросы заданы ТЕКУЩЕМУ дереву и
# окружение им нужно.
#
# 02.10.2026 я прошёл этот путь в обе стороны и оба раза мимо. Сначала `git -C "$root"`
# стоял там, где нужен был вопрос про текущее дерево, — и спасало только то, что `-C`
# не работал: трио «ветка / ORIG_HEAD / HEAD» оказывалось согласованным случайно. Потом я
# добавил снятие окружения — и сделал несогласованность настоящей: ветку брал у дерева
# слияния, а диапазон коммитов у главного, то есть выпуск записывался всей поставке на
# постороннем слиянии. Нашёл тестировщик, трассировкой хука. Правило после двух промахов
# одно: ответ берётся у того же дерева, которому задан вопрос.
# Запасного пути тут намеренно НЕТ. `git rev-parse --show-toplevel` в связанном дереве
# вернёт путь ЭТОГО дерева, а не главного, — ровно то, от чего уходили 01.10.2026, когда
# события уезжали в `.firm/events` ветки задачи. Если `worktree list` молчит, честнее выйти:
# неправильный корень хуже отсутствия события, потому что он пишет журнал не туда.
[ -n "$root" ] || { echo "[firm2] git worktree list не ответил — корень неизвестен, событие НЕ записано" >&2; exit 0; }
cfg="${root}/.firm/config"
[ -f "$cfg" ] || exit 0
grep -Eq '^engine:[[:space:]]*"?firm2"?' "$cfg" || exit 0

engine_root="$(sed -nE 's/^engine_root:[[:space:]]*"?([^"#]+)"?[[:space:]]*$/\1/p' "$cfg" | head -1)"
[ -n "$engine_root" ] || { echo "[firm2] в .firm/config нет engine_root — событие слияния не записано" >&2; exit 0; }
event_js="${engine_root}/scripts/firm-event.mjs"
[ -f "$event_js" ] || { echo "[firm2] не найден ${event_js}" >&2; exit 0; }

# КУДА влили. Это главный вопрос для выпуска, и до 02.10.2026 его не задавал никто:
# git-хуки общие для всех рабочих деревьев, поэтому `git merge feature/<поставка>` ВНУТРИ
# дерева задачи (законный ход — подтянуть в задачу правку из поставки) читался как «поставку
# влили в main». На проект-В это дало 22 ложных `release/finished` разом: поставка объявлена
# выпущенной, хотя ни MR-ревью всего диффа, ни демо-ворота не пройдены и PR не существует.
# `doctor` на это ничего не сказал.
#
# Это тот же дефект, что №1 от 01.10.2026, только в соседней ветке того же `if`: тогда
# починили ветку задачи, а ветку выпуска не тронули. Урок записан в доменной модели как
# правило «инвариант, проверяемый в одном месте и повторённый в другом, уже нарушен» — здесь
# он подтвердился буквально.
#
# HEAD берём БЕЗ `-C "$root"`: нужна ветка того дерева, где слияние случилось, а не главного.
into="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
# Ветка-получатель выпуска — главная ветка проекта. Ключ `vcs.target_branch` объявлен в
# шаблоне конфига с самого начала, но до сих пор его не читал никто.
target="$(sed -nE 's/^[[:space:]]*target_branch:[[:space:]]*"?([^"#]+)"?[[:space:]]*$/\1/p' "$cfg" | head -1)"
[ -n "$target" ] || target="main"

# Какую ветку только что влили: сообщение рефлога пишет сам git. Читаем его БЕЗ
# `-C "$root"`, по той же причине, что и `into` выше: рефлог `HEAD` у git по-деревный, и
# слияние записано в том дереве, где случилось. Читая рефлог главного дерева, хук брал
# ответ из одного места, а вопрос «куда влили» задавал про другое — и в дереве задачи
# видел постороннее (`checkout: moving from feature/... to main`).
#
# Сегодня это дало бы ложное событие в узком случае: главное дерево стоит на
# `feature/<поставка>` — обычное состояние во время сборки, — а рабочее дерево на главной
# ветке. Тогда `into` совпадает с целевой, а `merged` подтягивается из устаревшей записи
# чужого рефлога, и выпуск пишется на слиянии, которого сейчас не было. Третий случай
# одного класса за два дня: ответ надо брать там же, где задан вопрос.
msg="$(git reflog -1 --format=%gs 2>/dev/null)"
merged="$(printf '%s' "$msg" | sed -nE 's/^merge ([^:]+):.*/\1/p')"
ticket="$(printf '%s' "$merged" | sed -nE 's#^(.*/)?(T-[A-Za-z0-9._]+)$#\2#p')"

if [ -n "$ticket" ]; then
  # Хук — СПУСКОВОЙ КРЮЧОК, а не судья. Он зовёт сверку, и событие пишет она — по
  # доказательству из ADR-0005: мерж-коммит на ветке поставки, у которого вершина
  # task/T-XXX стоит вторым родителем.
  #
  # До 01.10.2026 хук писал `merge/finished` сам, по тексту рефлога, и этого хватало для
  # двух ложных событий. Первое: `git merge --ff-only task/T-001` — мерж-коммита нет,
  # событие есть, и `doctor` потом объявлял СОБСТВЕННОЕ событие невозможным. Второе, хуже:
  # git-хуки общие для всех рабочих деревьев, поэтому слияние ветки-зависимости ВНУТРИ
  # дерева задачи (`git merge --no-ff task/T-002` в дереве T-003) записывало T-002 как
  # влитую в поставку — хотя влили её в чужую ветку. Доска показывала `merged`, а
  # `build-args` вычёркивал задачу из следующего прогона.
  #
  # Признак «влито» теперь один на весь движок и живёт в коде, а не в трёх местах по-разному
  # (ADR-0005). Если слияние было не в поставку — сверка молчит, и это правильный ответ.
  # `--root "$root"` обязателен. Без него корень журнала ищется заново уже внутри node —
  # `CLAUDE_PROJECT_DIR || cwd`, — то есть ответ на вопрос «куда писать журнал» берётся не
  # оттуда, где вопрос задан, а из окружения сессии. Воспроизведено тестировщиком
  # 02.10.2026: `CLAUDE_PROJECT_DIR` указывает на проект A, слияние делается в проекте B —
  # сверка уходит в A, где доказывать нечего, и событие слияния теряется ВООБЩЕ. А если в A
  # найдётся ветка `task/` с тем же номером и мерж-коммит под неё, событие запишется по
  # чужому доказательству. Четвёртый случай того же класса за два дня.
  node "$event_js" sync --root "$root" >/dev/null
elif printf '%s' "$merged" | grep -q '^feature/'; then
  change="${merged#feature/}"
  if [ "$into" = "$target" ]; then
    node "$event_js" release --root "$root" --change "$change" --actor git-post-merge >/dev/null
  else
    # Поставку влили не в главную ветку — значит это не выпуск, а подтягивание правки в
    # задачу. Молчать нельзя: ход законный, но человек должен видеть, что события выпуска
    # НЕ будет, иначе он решит, что хук сломался.
    echo "[firm2] feature/${change} влита в ${into}, а не в ${target} — это не выпуск." >&2
    echo "        Событие release/finished НЕ записано, и это правильный ответ." >&2
    echo "        Выпуск — только слияние в ${target}; ветку выпуска задаёт vcs.target_branch." >&2
  fi
else
  # Слияние могло случиться НЕ здесь. `gh pr merge` сливает ветку поставки на стороне
  # GitHub, а локально приезжает `git pull --ff-only` — и рефлог пишет
  # «pull --ff-only: Fast-forward», где имени влитой ветки нет вовсе. Шаблон выше не
  # совпадает, и до 0.4.10 хук в этом случае молчал: поставка была слита, а события
  # выпуска не появлялись (Д-13 разбора 24.09.2026, события пришлось дописывать руками).
  #
  # Имя ветки берём не из рефлога, а из ПРИШЕДШИХ коммитов: слияние PR оставляет в
  # заголовке имя ветки-источника. Диапазон — ORIG_HEAD..HEAD, его git выставляет сам.
  # Ничего не нашли — молчим: выдумывать имя поставки хуже, чем не записать событие,
  # потому что неправда в журнале дороже дыры (её хотя бы видно в doctor).
  range_from="$(git rev-parse --verify --quiet ORIG_HEAD 2>/dev/null)"
  if [ -n "$range_from" ]; then
    change="$(git log --format=%s "${range_from}..HEAD" 2>/dev/null |
      sed -nE 's#.*feature/([A-Za-z0-9._-]+).*#\1#p' | head -1)"
    if [ -n "$change" ] && [ "$into" = "$target" ]; then
      node "$event_js" release --root "$root" --change "$change" --actor git-post-merge >/dev/null
    elif [ -n "$change" ]; then
      # Тот же вопрос, что и выше, и тот же ответ. Путь через ORIG_HEAD опаснее соседнего:
      # имя поставки он берёт из заголовков пришедших коммитов, то есть сработает и в дереве
      # задачи, куда эти коммиты приехали обычным `git pull`.
      echo "[firm2] поставка ${change} приехала в ${into}, а не в ${target} — это не выпуск." >&2
      echo "        Событие release/finished НЕ записано." >&2
    else
      echo "[firm2] слияние не опознано: ни ветки задачи, ни feature/<поставка> в рефлоге" >&2
      echo "        и ни одного feature/... в заголовках ${range_from}..HEAD." >&2
      echo "        Событие выпуска НЕ записано. Если поставка действительно слита:" >&2
      echo "        firm-event.mjs release --change <имя> --actor human" >&2
    fi
  else
    echo "[firm2] слияние не опознано и ORIG_HEAD не выставлен — событие НЕ записано." >&2
    echo "        Если поставка слита: firm-event.mjs release --change <имя> --actor human" >&2
  fi
fi

# Граф кода: инкрементальная пересборка занимает доли секунды, полагаться на живой
# watch в нужном каталоге нельзя.
if command -v codegraph >/dev/null 2>&1; then
  ( cd "$root" && codegraph build >/dev/null 2>&1 || true )
fi
exit 0
