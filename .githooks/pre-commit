#!/usr/bin/env bash
# Линтер перед коммитом. Поставлен 09.10.2026 по ретро: у репозитория не было ни CI, ни
# локального хука, и единственный шлюз — рубеж — срабатывал только изнутри bump-version.
# То есть коммит, трогающий ОДИН `firm2/scripts/`, не проходил ни одной проверки, — а это
# ровно то, что доезжает в проекты мгновенно, по engine_root, без всякой версии.
#
# Здесь именно линтер, а не рубеж: 0.8 секунды против полутора минут. Класс дефектов, за
# которым рубеж и ставился («обращение к тому, чего нет»), ловит как раз `no-undef`, и
# ловит статически — в неисполненных ветках тоже. Тесты (18 с) и прогон по синтетике
# остаются в рубеже, а рубеж — в доставке: `release.mjs` без него версию не поднимет.
#
# Обход честный и нужный: `git commit --no-verify`. Правка в одном .md не стоит даже
# секунды, а запрет, который нельзя обойти, обходят мимо git.
set -u
root="$(git rev-parse --show-toplevel)"
[ -d "$root/node_modules" ] || {
  echo "[pre-commit] node_modules нет — линтер пропущен (установка: см. ADR-0010)"
  exit 0
}
if ! out="$(cd "$root" && npm run --silent lint 2>&1)"; then
  printf '%s\n' "$out"
  echo
  echo "[pre-commit] линтер не прошёл — коммита нет. Исправить, либо git commit --no-verify."
  exit 1
fi
